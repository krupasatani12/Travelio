onfirmBookingTYpe();" id="Footer_btnsubmittxtConfirmation" class="btn5" /> </div> <div class="clearfix"></div> </div> </div> <!-- modal-content --> </div> <!-- modal-dialog --> </div> <!-- modal --> <!-- Modal --> <div class="modal fade" id="myModal_city" role="dialog"> <div class="modal-dialog"> <!-- Modal content--> <div class="modal-content"> <div class="modal-body"> </div> </div> </div> </div> <style>.modal-backdrop{ background-color: #f1f5e2!important; opacity: 0.8;}.modal-backdrop.in { opacity: .8;}.foot2 li:last-child {border-right: none;}</style> <script>function validatebookingengineFooter(hotelid) {//alert(hotelid);var today = new Date();//today.setDate(today.getDate() + 2);today.setDate(today.getDate());var tomorrow = new Date();//tomorrow.setDate(tomorrow.getDate() + 4);tomorrow.setDate(tomorrow.getDate() + 1);var dd = today.getDate();var mm = today.getMonth() + 1; //January is 0!//alert(mm);var yyyy = today.getFullYear();var dd1 = tomorrow.getDate();var mm1 = tomorrow.getMonth() + 1; //January is 0!var yyyy1 = tomorrow.getFullYear();if (mm < 10) {mm = '0' + mm;}//if(mm=='1'){var m = 'Jan';}else if(mm=='2')	{var m = 'Feb';	}else if(mm=='3'){var m = 'Mar';}else if(mm=='4'){var m = 'Apr';}//	else if(mm=='5'){var m = 'May';}else if(mm=='6'){var m = 'Jun';}else if(mm=='7'){var m = 'Jul';}else if(mm=='8'){var m = 'Aug';}//	else if(mm=='9'){var m = 'Sep';}else if(mm=='10'){var m = 'Oct';}else if(mm=='11'){var m = 'Nov';}else if(mm=='12')//	{//		var m = 'Dec';//	}if (dd1 < 10) {dd1 = '0' + dd1;}if (mm1 < 10) {mm1 = '0' + mm1;}//if(mm1=='1'){var m1 = 'Jan';}else if(mm1=='2')	{var m1 = 'Feb';	}else if(mm1=='3'){var m1 = 'Mar';}else if(mm1=='4'){var m1 = 'Apr';}else if(mm1=='5'){var m1 = 'May';}else if(mm1=='6'){var m1 = 'Jun';}else if(mm1=='7'){var m1 = 'Jul';}else if(mm1=='8'){var m1 = 'Aug';}else if(mm1=='9'){var m1 = 'Sep';}else if(mm1=='10'){var m1 = 'Oct';}else if(mm1=='11'){var m1 = 'Nov';}else if(mm1=='12')	{var m1 = 'Dec';}var checkin = mm + '/' + dd + '/' + yyyy;var checkout = mm1 + '/' + dd1 + '/' + yyyy1;var vurl = "?DateOut=" + checkout + "&DateIn=" + checkin + "&Adults=1&Children=0&Rooms=1&languageid=1";//var vurl = vurl.replace("undefined/undefined/", "");//alert(vurl);var url1 = "https://abcreservations.travelclick.com/" + hotelid + vurl;//window.location.href = url1;window.open(url1);}</script> </div> <!--swiper slider js start--> <!--<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css">--> <link rel='stylesheet' href='css/swiper.min.css' /> <link rel="stylesheet" href="css/style-slider.css" /> <script src='https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.0.7/js/swiper.min.js'></script> <script  src="js/index.js"></script> <!--swiper slider js end--> <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script> <script src="js/bootstrap.min.js"></script> <script src="js/owl.carousel.js"></script> <script src="js/script.js"></script> <script src="js/bootstrap.datepicker.min.js"></script> <script src="js/wow.min.js"></script> <script src='js/validationf.js'></script> <script>new WOW().init();
