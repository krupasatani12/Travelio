ontrol input-number befot" value="0" min="0" max="10"> <span class="input-group-btn"> <button type="button" class="btn bearrow btn-number" data-type="plus" data-field="quant[2]"> <span class="glyphicon glyphicon-plus"></span> </button> </span> </div> </div> <div class="col-md-2"> <div class="beline"></div> <label class="room_txt">Rooms</label> <div class="input-group"> <span class="input-group-btn"> <button type="button" class="btn bearrow btn-number" disabled="disabled" data-type="minus" data-field="quant[3]"> <span class="glyphicon glyphicon-minus"></span> </button> </span> <input type="text" name="quant[3]" id="rooms" class="form-control input-number befot" value="1" min="1" max="10"> <span class="input-group-btn"> <button type="button" class="btn bearrow btn-number" data-type="plus" data-field="quant[3]"> <span class="glyphicon glyphicon-plus"></span> </button> </span> </div> </div> <div class="col-md-2"> <label class="room_txt">Promo Code</label> <input name="" type="text" id="PromoCode" class="promocode_be" onfocus="if(this.value == 'Promo Code') { this.value = ''; }" onblur="if(this.value ==''){this.value = 'Promo Code';}" Placeholder="Promo Code"  /> </div> <div class="clearfix"></div> <div class="col-md-12 nopad"> <div class="chkbtn"> </div> <input type="button" id="btnbooknow" onclick="return checkBookingTYpe();" value="BOOK NOW"  class="custom-btn" /> <input type="button" onclick="return checkConValidate();" value="MODIFY BOOKING"  class="custom-btn" /> </div> <div class="clearfix"></div> </div> </div> <script>function Savebooking(sla) {// alert("Hi....Savebooking()");var room = $("#rooms").val();// alert(room);var hotel = $("#BookingEngine_DdlHotelBooking").val();//alert(hotel);var adults = $("#adults").val();//alert(adults);var rooms = $("#rooms").val();var checkin = $("#datepicker").val();//alert(checkin);var checkout = $("#datepicker1").val();var PromoCode = $("#PromoCode").val();var childrens = $("#childrens").val();//  alert($("[id$=DdlHotelBooking] option:selected").text());$.ajax({type: "POST",contentType: "application/json; charset=utf-8",url: 'ZoneHotel.asmx/BookingSaveForm',data: "{'HotelName':'Desktop - " + $("[id$=DdlHotelBooking] option:selected").text() + "','CheckInDate':'" + checkin + "','CheckOutDate':'" + checkout + "','NoOfAdults':'" + adults + "','PromoCode':'" + PromoCode + "','NoOfChild':'" + childrens + "','Room':'" + room + "','Bucket':'" + sla + "'}",cache: false,async: false,success: function (result) {//alert(result.d);//if (result.d == "Success") {//    $("#txtname").val("");//    $("#txtemail").val("");//    $("#arrivaldate").val("");//    $("#txtphone").val("");//    $("#drdguest").find('option:first').attr('selected', 'selected');//    //$("#DdlEquiryCountry").find('option:first').attr('selected', 'selected');//    $("#ddlhotel").find('option:first').attr('selected', 'selected');//}},Error: function (result) {alert(result.d);}});}
</script> <script>function checkConValidate() {var selectedHotel = $("[id$=_DdlHotelBooking]").val();if (selectedHotel == 0) {alert("Please select hotel");}else {$("#myModifyBook").modal("show");//data-toggle="modal" data-target=""}}function checkConfirmBookingTYpe() {var ConNumber = $("#txtConfirmation").val();//alert(ConNumber);var hotel = $("[id$=_DdlHotelBooking]").val();//alert(hotel);var LastNameCon = $("#txtLastNameCon").val();if (ConNumber == '') {alert("Please Enter Confirmation Number");return false;}else if (LastNameCon == '') {alert("Please Enter Last Name");return false;}else {var vurl = "?confirmid=" + ConNumber + "&languageid=1#/guestsandrooms";var url1 = "https://reservations1.travelclick.com/" + hotel + vurl;if (hotel == "999007") {var url1 = "https://www.zonebythepark.com/prayagraj-hotels/zone-connect-by-the-park-prayagraj";}else if (hotel == "999008") {var url1 = "https://zonebythepark.ihotelier.com/zoneconnect-park-jaisalmer/book/dates-of-stay";}alert(url1);window.open(url1);//window.location.href = url1;return false;}}</script> </div> <section class="stealdeal"> <div class="container-fluid"> <div class="offer_org1"></div> <div class="offer_org2"></div> <div class="offer_org3"></div> <div class="dealwarp1 "> <img src="img/news_icon.png" alt="" /> <h2 class="wow fadeInUp">#404</h2> <div class="arrow1"></div> </div> <div class="dealwarp3"> <div class="col-md-12"> <hr class="hr_line4" /> <div class="clearfix"></div> <div class="wrapper"> </div> <p> <h3 style="text-align:center;">THIS PAGE DOES NOT EXIST.<br />
