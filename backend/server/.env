# ═══════════════════════════════════════════════════════════════
# TravelIO Server Environment Variables
# ═══════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB Atlas ────────────────────────────────────────────
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# Replace <username>, <password>, and <cluster-url> with your own
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=TravelIO

# ─── JWT Authentication ──────────────────────────────────────
# Use a strong, random secret (min 32 chars recommended)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# ─── Email / SMTP (Gmail) ────────────────────────────────────
# For Gmail, enable 2FA and generate an App Password:
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Django ML Microservice ──────────────────────────────────
# URL of the Django ML service (runs on port 8000 by default)
DJANGO_ML_URL=http://localhost:8000/api

# ─── Mistral AI (Chatbot) ────────────────────────────────────
# Get your API key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# ─── Google Gemini AI ─────────────────────────────────────────
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
