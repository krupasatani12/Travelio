{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ml-service": {
      "root": "backend/ml-service",
      "framework": "django"
    },
    "server": {
      "root": "backend/server",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
